# Port the HTTP server listens on.
PORT=3001
# Most calls that can be live at once, from 1 to 30.
MAX_PARALLEL_CALLS=3
# Milliseconds after the first quote before the head agent decides anyway.
DECISION_WINDOW_MS=20000
# Milliseconds to wait after every call settles, so a negotiated drop can land.
SETTLE_GRACE_MS=8000
# Milliseconds after a run starts before the head agent must decide.
RUN_TIMEOUT_MS=120000
# Flag a price check line when it differs from the reference by more than this percent.
PRICE_FLAG_PCT=10
# Which provider places the calls: "fake" for scripted calls, "text" for two AI models talking.
PROVIDER=fake
# OpenAI API key, required when PROVIDER is "text".
OPENAI_API_KEY=
# Any current fast OpenAI chat model with tool calling.
OPENAI_MODEL=
# Most caller turns before a call is cut.
MAX_TURNS=14
