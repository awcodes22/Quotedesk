# Address the HTTP server listens on. Keep 127.0.0.1 unless you need other machines to reach it.
HOST=127.0.0.1
# Port the HTTP server listens on.
PORT=3001
# Most calls that can be live at once, from 1 to 30.
MAX_PARALLEL_CALLS=3
# Milliseconds after the first quote before the head agent decides anyway.
DECISION_WINDOW_MS=20000
# Milliseconds to wait after every call settles, so a negotiated drop can land.
SETTLE_GRACE_MS=3000
# Milliseconds after a run starts before the head agent must decide.
RUN_TIMEOUT_MS=120000
# Flag a price check line when it differs from the reference by more than this percent.
PRICE_FLAG_PCT=10
# Which provider the CLI uses by default: "fake" for scripted calls, "text" for two AI models talking.
PROVIDER=fake
# OpenAI API key, required for "text" runs and for reading quotes out of live calls.
OPENAI_API_KEY=
# Any current fast OpenAI chat model with tool calling.
OPENAI_MODEL=
# Most caller turns before a call is cut.
MAX_TURNS=14

# Live phone calls through ElevenLabs and Twilio. Live mode stays off until the keys, the guest
# name and at least one of LIVE_ALLOWED_NUMBERS or LIVE_TEST_NUMBER are set.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# The guest name the caller gives when the hotel asks.
LIVE_GUEST_NAME=
# Comma-separated numbers in E.164 format, such as +15555550123. Nothing else is ever dialed.
LIVE_ALLOWED_NUMBERS=
# Your own phone in E.164 format, for "Test with my phone". Always allowed, never sent to the browser.
LIVE_TEST_NUMBER=
# Most live calls per run, from 1 to 6.
LIVE_MAX_CALLS=6
# Milliseconds a live call may take before it is given up on.
LIVE_CALL_TIMEOUT_MS=300000
